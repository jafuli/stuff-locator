{
  "name": "stuff-locator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/free-port.mjs && node scripts/copy-ort.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "next build",
    "prestart": "node scripts/free-port.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file-if-exists=.env.rls.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "node --env-file-if-exists=.env.rls.local node_modules/.bin/playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@serwist/turbopack": "^9.5.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "downshift": "^9.5.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.0",
    "prettier": "3.10.1",
    "serwist": "^9.5.12",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
