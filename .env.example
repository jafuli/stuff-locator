# Supabase project settings > API — https://app.supabase.com/project/_/settings/api
# For local development, `npm run supabase:start` prints these values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Not referenced anywhere in this scaffold — reserved for the
# redeem_invite RPC (written in a Pair session), the one place this app uses
# a service-role client. Never prefix with NEXT_PUBLIC_, never forward to a
# browser client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Note: Supabase is migrating from anon/service_role keys to publishable/
# secret keys (deprecating the old names by end of 2026). This scaffold uses
# the current names to match what's documented in CLAUDE.md — worth
# reconfirming before the Pair session wires up auth against a real project.
