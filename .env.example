# Supabase project settings > API — https://app.supabase.com/project/_/settings/api
# For local development, `npm run supabase:start` prints these values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, and NOT used by the app at runtime: every privileged write
# (create_household, redeem_invite) is a SECURITY DEFINER Postgres function
# called with the signed-in user's own JWT. The service-role key is only for
# the integration tests under supabase/tests/ (seeding and cleanup, via
# .env.rls.local). Never prefix with NEXT_PUBLIC_, never ship it to a browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Note: Supabase is migrating from anon/service_role keys to publishable/
# secret keys (deprecating the old names by end of 2026). This scaffold uses
# the current names to match what's documented in CLAUDE.md — worth
# reconfirming before the Pair session wires up auth against a real project.
