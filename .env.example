# Every variable the app reads (validated at start-up in src/lib/env.ts).
# Local: `npm run supabase:start` prints the values. Production: Supabase
# project settings → API Keys. Both are NEXT_PUBLIC_, so they're inlined into
# the client bundle at build time: changing one on Vercel needs a redeploy.
# See DEPLOYMENT.md.

# The project's API URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The browser-safe key. Use the publishable key (sb_publishable_…) for production; the legacy JWT anon key also works but is deprecated by end of 2026. The name is kept for now (DEPLOYMENT.md §1).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only, and NOT used by the app at runtime: every privileged write
# (create_household, redeem_invite, stash_item, …) is a SECURITY DEFINER
# Postgres function called with the signed-in user's own JWT. The
# service-role / secret key is only for the integration tests under
# supabase/tests/ (seeding and cleanup, via .env.rls.local). Never prefix it
# with NEXT_PUBLIC_, never set it on Vercel, never ship it to a browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
